pkgname=cockpit-git-server
pkgver=VERSION
pkgrel=1
pkgdesc='Cockpit Git Server Management Extension'
arch=('x86_64')
url='https://github.com/cockpit-project/cockpit-git-server'
license=(LGPL)
source=("SOURCE")
sha256sums=('SKIP')

package() {
  depends=(cockpit)
  cd $pkgname
  make DESTDIR="$pkgdir" install PREFIX=/usr
}
