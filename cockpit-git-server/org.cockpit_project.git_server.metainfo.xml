<?xml version="1.0" encoding="UTF-8"?>
<component type="addon">
  <id>org.cockpit_project.git_server</id>
  <metadata_license>CC0-1.0</metadata_license>
  <name>Git Server</name>
  <summary>Cockpit extension for managing bare Git repositories</summary>
  <description>
    <p>
      A Cockpit extension for managing bare Git repositories on a Linux server.
      Provides repository CRUD, browsing, service management, and SSH access control.
    </p>
  </description>
  <extends>org.cockpit_project.cockpit</extends>
  <launchable type="cockpit-manifest">git-server</launchable>
  <url type="homepage">https://github.com/cockpit-project/cockpit-git-server</url>
  <url type="bugtracker">https://github.com/cockpit-project/cockpit-git-server/issues</url>
  <update_contact>cockpit-devel_AT_lists.fedorahosted.org</update_contact>
  <developer id="org.cockpit-project">
    <name>Cockpit Project</name>
  </developer>
</component>
